<UserControl x:Class="FFTicket.Desktop.Views.TicketOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Tag="Search tickets" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Statuses}" SelectedItem="{Binding StatusFilter}" Margin="0,0,10,0" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding Urgencies}" SelectedItem="{Binding UrgencyFilter}" Margin="0,0,10,0" />
                <Button Grid.Column="3" Command="{Binding RefreshCommand}">
                    <TextBlock Text="Filter" />
                </Button>
                <DatePicker Grid.Column="4" SelectedDate="{Binding ReportFrom}" Margin="8,0,0,0" />
                <Button Grid.Column="5" Command="{Binding ExportCommand}">
                    <TextBlock Text="Export CSV" />
                </Button>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Selected Ticket" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" Width="170" />
                <ComboBox ItemsSource="{Binding Urgencies}" SelectedItem="{Binding SelectedUrgency}" Width="130" />
                <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedAssignee}" DisplayMemberPath="Name" Width="190" />
                <Button Command="{Binding UpdateSelectedCommand}" IsEnabled="{Binding SelectedTicket, Converter={StaticResource NullToBooleanConverter}}">
                    <TextBlock Text="Apply Changes" />
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenDetailCommand}" IsEnabled="{Binding SelectedTicket, Converter={StaticResource NullToBooleanConverter}}">
                    <TextBlock Text="Detail" />
                </Button>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B33813" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Tickets}" SelectedItem="{Binding SelectedTicket}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNumber}" Width="115" />
                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*" />
                    <DataGridTextColumn Header="Creator" Binding="{Binding CreatorName}" Width="140" />
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120" />
                    <DataGridTemplateColumn Header="Status" Width="155">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusBadge}">
                                    <TextBlock Text="{Binding Status}" Foreground="White" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Urgency" Binding="{Binding Urgency}" Width="90" />
                    <DataGridTextColumn Header="Assigned" Binding="{Binding AssigneeName}" Width="140" />
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>

<UserControl
    x:Class="FFTicket.Desktop.Views.TicketOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:models="using:FFTicket.Desktop.Models"
    xmlns:ui="using:FFTicket.Desktop.Controls"
    xmlns:views="using:FFTicket.Desktop.Views">
    <SplitView
        x:Name="DetailSplitView"
        DisplayMode="Overlay"
        IsPaneOpen="{Binding IsDetailPaneOpen, Mode=TwoWay}"
        OpenPaneLength="540"
        PanePlacement="Right">
        <SplitView.Pane>
            <Grid
                Width="540"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="72" />
                </Grid.RowDefinitions>

                <Grid Padding="20,12">
                    <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Ticket Detail" />
                    <Button
                        HorizontalAlignment="Right"
                        Style="{StaticResource IconButton}"
                        Command="{Binding CloseDetailCommand}"
                        ToolTipService.ToolTip="Close detail pane">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="20,8,20,20" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <views:TicketDetailView DataContext="{Binding Detail}" />

                        <Border
                            Padding="16"
                            Background="{ThemeResource ControlBackgroundBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Assignment and status" />
                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="Status" />
                                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="Urgency" />
                                <ComboBox
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding UrgencyTypes}"
                                    SelectedItem="{Binding SelectedUrgencyType, Mode=TwoWay}" />
                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="Assigned to" />
                                <ComboBox
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding Users}"
                                    SelectedItem="{Binding SelectedAssignee, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid
                    Grid.Row="2"
                    Padding="20,12"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <TextBlock Foreground="{ThemeResource SuccessTextBrush}" Text="{Binding SuccessMessage}" />
                        <TextBlock Foreground="{ThemeResource ErrorTextBrush}" Text="{Binding ErrorMessage}" />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding UpdateSelectedCommand}"
                        Content="Apply Changes"
                        IsEnabled="{Binding SelectedTicket, Converter={StaticResource NullToBooleanConverter}}" />
                </Grid>
            </Grid>
        </SplitView.Pane>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Translation="0,0,16">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Ticket Overview" />
                            <TextBlock
                                Margin="0,3,0,0"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="Review, assign, and resolve support requests." />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Command="{Binding ExportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                <TextBlock Text="Export CSV" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <Grid MinWidth="870" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="Status" />
                                <ComboBox ItemsSource="{Binding FilterStatuses}" SelectedItem="{Binding StatusFilter, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="Urgency" />
                                <ComboBox ItemsSource="{Binding UrgencyFilterOptions}" SelectedItem="{Binding UrgencyFilter, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="Created From" />
                                <CalendarDatePicker
                                    DateChanged="ReportDate_DateChanged"
                                    DateFormat="{}{day.integer}/{month.integer}/{year.full}"
                                    Date="{Binding ReportFrom, Mode=TwoWay}"
                                    PlaceholderText="Created from" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="5">
                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="Created To" />
                                <CalendarDatePicker
                                    DateChanged="ReportDate_DateChanged"
                                    DateFormat="{}{day.integer}/{month.integer}/{year.full}"
                                    Date="{Binding ReportTo, Mode=TwoWay}"
                                    PlaceholderText="Created to" />
                            </StackPanel>
                            <Button
                                Grid.Column="4"
                                Margin="0,23,0,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}"
                                Content="Apply Filters" />
                            <Button
                                Grid.Column="5"
                                Margin="0,23,0,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource IconButton}"
                                Command="{Binding RefreshCommand}"
                                ToolTipService.ToolTip="Refresh tickets">
                                <FontIcon Glyph="&#xE72C;" />
                            </Button>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Translation="0,0,16">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <controls:DataGrid
                        x:Name="TicketsGrid"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="True"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Tickets}"
                        RowHeight="52"
                        SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                        SelectionMode="Single">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Ticket" Binding="{Binding TicketNumber}" Width="185" />
                            <controls:DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="180" />
                            <controls:DataGridTextColumn Header="Creator" Binding="{Binding CreatorName}" Width="140" />
                            <controls:DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120" />
                            <controls:DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="130" />
                            <controls:DataGridTemplateColumn Header="Status" Width="155">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:SemanticBadge Kind="Status" Text="{Binding Status}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTemplateColumn Header="Urgency" Width="108">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:SemanticBadge Kind="Urgency" Text="{Binding Urgency}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTextColumn Header="Assigned" Binding="{Binding AssigneeName}" Width="140" />
                            <controls:DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="150" />
                            <controls:DataGridTemplateColumn Header="Actions" Width="86">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Style="{StaticResource IconButton}"
                                            Click="OpenTicket_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Open ticket">
                                            <FontIcon Glyph="&#xE70F;" />
                                        </Button>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <ProgressRing
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="{Binding IsBusy}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
    </SplitView>
</UserControl>

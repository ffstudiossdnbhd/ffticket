<UserControl x:Class="FFTicket.Desktop.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Tag="Name" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Tag="Email" Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <TextBox Grid.Column="2" Tag="Password optional" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Command="{Binding CreateCommand}">
                    <TextBlock Text="Add User" />
                </Button>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Reset Password" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Tag="New password" Text="{Binding ResetPassword, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" />
                <Button Command="{Binding UpdateCommand}" IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBooleanConverter}}">
                    <TextBlock Text="Save Selected" />
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCommand}" IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBooleanConverter}}">
                    <TextBlock Text="Delete Selected" />
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}">
                    <TextBlock Text="Refresh" />
                </Button>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B33813" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="160" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>

<UserControl
    x:Class="FFTicket.Desktop.Views.StaffDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:ui="using:FFTicket.Desktop.Controls">
    <Grid
        x:Name="LayoutRoot"
        Padding="8"
        SizeChanged="LayoutRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FormColumn" Width="400" />
            <ColumnDefinition x:Name="TicketsColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="FormRow" Height="*" />
            <RowDefinition x:Name="TicketsRow" Height="0" />
        </Grid.RowDefinitions>

        <Border
            x:Name="FormCard"
            Grid.Row="0"
            Grid.Column="0"
            Style="{StaticResource Card}"
            Translation="0,0,16"
            DataContext="{Binding CreateForm}">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="9">
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Submit Ticket" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="Tell IT what is happening and where." />
                    </StackPanel>

                    <Border
                        Style="{StaticResource MessageSurface}"
                        Background="{ThemeResource SuccessSurfaceBrush}"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Foreground="{ThemeResource SuccessTextBrush}" Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                    </Border>
                    <Border
                        Style="{StaticResource MessageSurface}"
                        Background="{ThemeResource ErrorSurfaceBrush}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Foreground="{ThemeResource ErrorTextBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="Category" />
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                    <TextBlock Margin="0,4,0,0" Foreground="{ThemeResource TextSecondaryBrush}" Text="Location" />
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Locations}"
                        SelectedItem="{Binding SelectedLocation, Mode=TwoWay}" />

                    <TextBlock Margin="0,4,0,0" Foreground="{ThemeResource TextSecondaryBrush}" Text="Subject" />
                    <TextBox
                        PlaceholderText="Brief issue summary"
                        Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,4,0,0" Foreground="{ThemeResource TextSecondaryBrush}" Text="Description" />
                    <TextBox
                        Height="128"
                        AcceptsReturn="True"
                        PlaceholderText="Describe the issue, error message, and affected device"
                        Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <Button
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding PickAttachmentCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="14" Glyph="&#xE723;" />
                            <TextBlock Text="Choose Attachment" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        MinHeight="18"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{Binding AttachmentPath}"
                        TextTrimming="CharacterEllipsis" />

                    <Grid Margin="0,8,0,0">
                        <ProgressRing
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Left"
                            IsActive="{Binding IsBusy}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{Binding SubmitCommand}"
                            Content="Submit Ticket" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            x:Name="TicketsCard"
            Grid.Row="0"
            Grid.Column="1"
            Style="{StaticResource Card}"
            Translation="0,0,16"
            Padding="0">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="20,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="My Submitted Tickets" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="Track your active and completed requests." />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button
                            Style="{StaticResource IconButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTipService.ToolTip="Refresh tickets">
                            <FontIcon Glyph="&#xE72C;" />
                        </Button>
                        <Button
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenDetailCommand}"
                            Content="Open Detail"
                            IsEnabled="{Binding SelectedTicket, Converter={StaticResource NullToBooleanConverter}}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <controls:DataGrid
                        x:Name="TicketsGrid"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="True"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        DoubleTapped="TicketsGrid_DoubleTapped"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding VisibleTickets}"
                        RowHeight="52"
                        SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                        SelectionMode="Single">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Ticket" Binding="{Binding TicketNumber}" Width="112" />
                            <controls:DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*" />
                            <controls:DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="130" />
                            <controls:DataGridTemplateColumn Header="Status" Width="155">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ui:SemanticBadge
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Kind="Status"
                                                Text="{Binding Status}" />
                                        </Grid>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTemplateColumn Header="Urgency" Width="108">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:SemanticBadge Kind="Urgency" Text="{Binding Urgency}" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="150" />
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{Binding HasVisibleTickets, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="34"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Glyph="&#xE8A5;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="No tickets found" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="Submit a ticket or adjust your search." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="FFTicket.Desktop.Views.StaffDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Grid.Column="0" DataContext="{Binding CreateForm}">
            <StackPanel>
                <TextBlock Text="Submit Ticket" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Border Background="#ECFDF3" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534" />
                </Border>
                <Border Background="#FFF3EE" BorderBrush="#FFD0BF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#B33813" />
                </Border>

                <TextBlock Text="Category" Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" />

                <TextBlock Text="Location" Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" DisplayMemberPath="Name" />

                <TextBlock Text="Subject" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Tag="Brief issue summary" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Description" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Tag="Describe the issue, error message, and affected device" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="130" TextWrapping="Wrap" />

                <Button Style="{StaticResource SecondaryButton}" Command="{Binding PickAttachmentCommand}" HorizontalAlignment="Left">
                    <TextBlock Text="Choose Attachment" />
                </Button>
                <TextBlock Text="{Binding AttachmentPath}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="4,4,0,12" />

                <Button Command="{Binding SubmitCommand}">
                    <TextBlock Text="Submit Ticket" />
                </Button>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Grid.Column="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="My Submitted Tickets" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="12,0,0,0">
                        <TextBlock Text="Refresh" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenDetailCommand}" IsEnabled="{Binding SelectedTicket, Converter={StaticResource NullToBooleanConverter}}">
                        <TextBlock Text="Open Detail" />
                    </Button>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Tickets}" SelectedItem="{Binding SelectedTicket}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="TicketsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNumber}" Width="110" />
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*" />
                        <DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="130" />
                        <DataGridTemplateColumn Header="Status" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}">
                                        <TextBlock Text="{Binding Status}" Foreground="White" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Urgency" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource UrgencyBadge}" Visibility="{Binding Urgency, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Urgency}" Foreground="White" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="FFTicket.Desktop.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <TabItem Header="Ticket Overview">
            <ContentControl Content="{Binding TicketOverview}" />
        </TabItem>
        <TabItem Header="Kanban Board">
            <ContentControl Content="{Binding KanbanBoard}" />
        </TabItem>
        <TabItem Header="User Management">
            <ContentControl Content="{Binding UserManagement}" />
        </TabItem>
    </TabControl>
</UserControl>


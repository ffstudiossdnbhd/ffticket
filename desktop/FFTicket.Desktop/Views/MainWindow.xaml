<Window x:Class="FFTicket.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFTicket"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="{StaticResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FFTicket" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Text="Support Console" Margin="12,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Run Text="{Binding CurrentUserName}" />
                    <Run Text=" · " />
                    <Run Text="{Binding CurrentRole}" />
                </TextBlock>
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentView}" Margin="12" />
    </DockPanel>
</Window>


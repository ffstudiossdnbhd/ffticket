<Window
    x:Class="FFTicket.Desktop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundBrush}"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid x:Name="TitleBarDragRegion" Background="Transparent" />
            <Grid Margin="18,8,152,8">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="CompactHeader" />
                        <VisualState x:Name="WideHeader">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1200" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="UserIdentity.Width" Value="220" />
                                <Setter Target="ChangePasswordButton.Width" Value="Auto" />
                                <Setter Target="ChangePasswordButton.Padding" Value="18,10" />
                                <Setter Target="ChangePasswordLabel.Visibility" Value="Visible" />
                                <Setter Target="LogoutButton.Width" Value="Auto" />
                                <Setter Target="LogoutButton.Padding" Value="18,10" />
                                <Setter Target="LogoutLabel.Visibility" Value="Visible" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                    <Image Width="46" Height="46" Source="ms-appx:///Assets/AppIcon.png" Stretch="Uniform" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryAccentBrush}"
                            Text="FFTicket" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="Support Console" />
                    </StackPanel>
                </StackPanel>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    MinWidth="0"
                    MaxWidth="360"
                    Margin="16,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    PlaceholderText="Search tickets"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <PersonPicture
                        Width="38"
                        Height="38"
                        AutomationProperties.Name="{Binding CurrentUserName}" />
                    <StackPanel
                        x:Name="UserIdentity"
                        Width="150"
                        VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding CurrentUserName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="{Binding CurrentRole}" />
                    </StackPanel>
                    <Button
                        x:Name="ChangePasswordButton"
                        Width="42"
                        Height="40"
                        Padding="0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ChangePasswordCommand}"
                        ToolTipService.ToolTip="Change Password">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="14" Glyph="&#xE8D7;" />
                            <TextBlock x:Name="ChangePasswordLabel" Visibility="Collapsed" Text="Change Password" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Width="42"
                        Height="40"
                        Padding="0"
                        Style="{StaticResource SecondaryButton}"
                        Click="ShowSettingsDialog"
                        ToolTipService.ToolTip="Desktop Settings">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                    </Button>
                    <Button
                        x:Name="LogoutButton"
                        Width="42"
                        Height="40"
                        Padding="0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding LogoutCommand}"
                        ToolTipService.ToolTip="Logout">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="14" Glyph="&#xF3B1;" />
                            <TextBlock x:Name="LogoutLabel" Visibility="Collapsed" Text="Logout" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <ContentControl
            x:Name="MainContent"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
    </Grid>
</Window>

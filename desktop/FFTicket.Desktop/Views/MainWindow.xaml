<Window x:Class="FFTicket.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFTicket"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="{StaticResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/AppIcon.png" Width="58" Height="58" Stretch="Uniform" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FFTicket" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" />
                        <TextBlock Text="Support Console" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding CurrentUserName, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding CurrentRole, Mode=OneWay}" />
                    </TextBlock>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ChangePasswordCommand}" Margin="14,0,0,0" Padding="12,5">
                        <TextBlock Text="Change Password" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding LogoutCommand}" Margin="14,0,0,0" Padding="12,5">
                        <TextBlock Text="Logout" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentView}" Margin="12" />
    </DockPanel>
</Window>

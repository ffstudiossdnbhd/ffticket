<Window x:Class="FFTicket.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFTicket Login"
        Width="440"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Style="{StaticResource Card}" Width="340" Padding="18,14,18,18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="FFTicket" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" />
                <TextBlock Text="IT Support Ticketing" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,28" />

                <Border Background="#FFF3EE" BorderBrush="#FFD0BF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#B33813" />
                </Border>

                <TextBlock Text="Email" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Tag="Email address" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Password" Foreground="{StaticResource TextSecondaryBrush}" />
                <PasswordBox x:Name="PasswordInput" />

                <CheckBox Content="Remember me" IsChecked="{Binding RememberMe}" Margin="0,0,0,16" />

                <Button x:Name="LoginButton" Click="LoginButton_Click">
                    <TextBlock Text="Sign in" />
                </Button>
                <TextBlock Text="Signing in..." HorizontalAlignment="Center" Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

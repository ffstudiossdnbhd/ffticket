<UserControl x:Class="FFTicket.Desktop.Views.CustomizeTicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}">
                    <TextBlock Text="Refresh" />
                </Button>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B33813" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <TabControl Margin="8">
            <TabItem Header="Categories">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Tag="Name" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Tag="Description" Text="{Binding NewCategoryDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Command="{Binding AddCategoryCommand}">
                                <TextBlock Text="Add Category" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveCategoryCommand}" IsEnabled="{Binding SelectedCategory, Converter={StaticResource NullToBooleanConverter}}">
                                <TextBlock Text="Save Selected" />
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCategoryCommand}" IsEnabled="{Binding SelectedCategory, Converter={StaticResource NullToBooleanConverter}}">
                                <TextBlock Text="Deactivate Selected" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Urgency Types">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Tag="Name" Text="{Binding NewUrgencyTypeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Tag="Description" Text="{Binding NewUrgencyTypeDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Command="{Binding AddUrgencyTypeCommand}">
                                <TextBlock Text="Add Urgency" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveUrgencyTypeCommand}" IsEnabled="{Binding SelectedUrgencyType, Converter={StaticResource NullToBooleanConverter}}">
                                <TextBlock Text="Save Selected" />
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteUrgencyTypeCommand}" IsEnabled="{Binding SelectedUrgencyType, Converter={StaticResource NullToBooleanConverter}}">
                                <TextBlock Text="Deactivate Selected" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DataGrid ItemsSource="{Binding UrgencyTypes}" SelectedItem="{Binding SelectedUrgencyType}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Locations">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Tag="Name" Text="{Binding NewLocationName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Tag="Description" Text="{Binding NewLocationDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Command="{Binding AddLocationCommand}">
                                <TextBlock Text="Add Location" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveLocationCommand}" IsEnabled="{Binding SelectedLocation, Converter={StaticResource NullToBooleanConverter}}">
                                <TextBlock Text="Save Selected" />
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteLocationCommand}" IsEnabled="{Binding SelectedLocation, Converter={StaticResource NullToBooleanConverter}}">
                                <TextBlock Text="Deactivate Selected" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DataGrid ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

<UserControl
    x:Class="FFTicket.Desktop.Views.CustomizeTicketView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Customize Ticket" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="Manage categories, urgency types, and ticket locations." />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Foreground="{ThemeResource SuccessTextBrush}" Text="{Binding SuccessMessage}" />
                    <TextBlock Foreground="{ThemeResource ErrorTextBrush}" Text="{Binding ErrorMessage}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabView
            Grid.Row="1"
            Margin="8"
            IsAddTabButtonVisible="False">
            <TabViewItem Header="Categories" IsClosable="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="Name" Text="{Binding NewCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" PlaceholderText="Description" Text="{Binding NewCategoryDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Command="{Binding AddCategoryCommand}" Content="Add Category" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <controls:DataGrid
                            AutoGenerateColumns="False"
                            GridLinesVisibility="None"
                            ItemsSource="{Binding Categories}"
                            RowHeight="50"
                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" />
                                <controls:DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay}" Width="*" />
                                <controls:DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=TwoWay}" Width="2*" />
                                <controls:DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, Mode=TwoWay}" Width="90" />
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Button
                                HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}"
                                Content="Refresh" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Command="{Binding SaveCategoryCommand}"
                                    Content="Save Selected"
                                    IsEnabled="{Binding SelectedCategory, Converter={StaticResource NullToBooleanConverter}}" />
                                <Button
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DeleteCategoryCommand}"
                                    Content="Deactivate Selected"
                                    IsEnabled="{Binding SelectedCategory, Converter={StaticResource NullToBooleanConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Urgency Types" IsClosable="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="Name" Text="{Binding NewUrgencyTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" PlaceholderText="Description" Text="{Binding NewUrgencyTypeDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Command="{Binding AddUrgencyTypeCommand}" Content="Add Urgency" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <controls:DataGrid
                            AutoGenerateColumns="False"
                            GridLinesVisibility="None"
                            ItemsSource="{Binding UrgencyTypes}"
                            RowHeight="50"
                            SelectedItem="{Binding SelectedUrgencyType, Mode=TwoWay}">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" />
                                <controls:DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay}" Width="*" />
                                <controls:DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=TwoWay}" Width="2*" />
                                <controls:DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, Mode=TwoWay}" Width="90" />
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Button
                                HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}"
                                Content="Refresh" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Command="{Binding SaveUrgencyTypeCommand}"
                                    Content="Save Selected"
                                    IsEnabled="{Binding SelectedUrgencyType, Converter={StaticResource NullToBooleanConverter}}" />
                                <Button
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DeleteUrgencyTypeCommand}"
                                    Content="Deactivate Selected"
                                    IsEnabled="{Binding SelectedUrgencyType, Converter={StaticResource NullToBooleanConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Locations" IsClosable="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="Name" Text="{Binding NewLocationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" PlaceholderText="Description" Text="{Binding NewLocationDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Command="{Binding AddLocationCommand}" Content="Add Location" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <controls:DataGrid
                            AutoGenerateColumns="False"
                            GridLinesVisibility="None"
                            ItemsSource="{Binding Locations}"
                            RowHeight="50"
                            SelectedItem="{Binding SelectedLocation, Mode=TwoWay}">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" />
                                <controls:DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay}" Width="*" />
                                <controls:DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=TwoWay}" Width="2*" />
                                <controls:DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, Mode=TwoWay}" Width="90" />
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Button
                                HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}"
                                Content="Refresh" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Command="{Binding SaveLocationCommand}"
                                    Content="Save Selected"
                                    IsEnabled="{Binding SelectedLocation, Converter={StaticResource NullToBooleanConverter}}" />
                                <Button
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DeleteLocationCommand}"
                                    Content="Deactivate Selected"
                                    IsEnabled="{Binding SelectedLocation, Converter={StaticResource NullToBooleanConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</UserControl>

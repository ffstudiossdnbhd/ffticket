<UserControl
    x:Class="FFTicket.Desktop.Views.KanbanBoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FFTicket.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Kanban Board" />
                    <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="Move tickets through the support workflow." />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <TextBlock Foreground="{ThemeResource ErrorTextBrush}" Text="{Binding ErrorMessage}" />
                    <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Refresh board">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid MinWidth="960">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,12" FontSize="17" FontWeight="SemiBold" Text="Open" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OpenTickets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="13" Background="{ThemeResource ControlBackgroundBrush}" CornerRadius="12" DoubleTapped="TicketCard_DoubleTapped">
                                            <StackPanel Spacing="6">
                                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding TicketNumber}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" TextWrapping="Wrap" />
                                                <ui:SemanticBadge Kind="Urgency" Text="{Binding Urgency}" />
                                                <Button HorizontalAlignment="Left" Click="StartTicket_Click" Content="Start" Tag="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,12" FontSize="17" FontWeight="SemiBold" Text="In Progress" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding InProgressTickets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="13" Background="{ThemeResource ControlBackgroundBrush}" CornerRadius="12" DoubleTapped="TicketCard_DoubleTapped">
                                            <StackPanel Spacing="6">
                                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding TicketNumber}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" TextWrapping="Wrap" />
                                                <ui:SemanticBadge Kind="Urgency" Text="{Binding Urgency}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Button Click="PendingTicket_Click" Content="Pending" Tag="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButton}" Click="CloseTicket_Click" Content="Close" Tag="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,12" FontSize="17" FontWeight="SemiBold" Text="Pending User Input" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PendingTickets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="13" Background="{ThemeResource ControlBackgroundBrush}" CornerRadius="12" DoubleTapped="TicketCard_DoubleTapped">
                                            <StackPanel Spacing="6">
                                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding TicketNumber}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" TextWrapping="Wrap" />
                                                <ui:SemanticBadge Kind="Urgency" Text="{Binding Urgency}" />
                                                <Button HorizontalAlignment="Left" Click="StartTicket_Click" Content="Resume" Tag="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,12" FontSize="17" FontWeight="SemiBold" Text="Closed" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ClosedTickets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="13" Background="{ThemeResource ControlBackgroundBrush}" CornerRadius="12" DoubleTapped="TicketCard_DoubleTapped">
                                            <StackPanel Spacing="6">
                                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding TicketNumber}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" TextWrapping="Wrap" />
                                                <ui:SemanticBadge Kind="Urgency" Text="{Binding Urgency}" />
                                                <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="ReopenTicket_Click" Content="Reopen" Tag="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

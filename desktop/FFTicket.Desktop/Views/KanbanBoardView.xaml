<UserControl x:Class="FFTicket.Desktop.Views.KanbanBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="Kanban Board" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="12,0,0,0">
                <TextBlock Text="Refresh" />
            </Button>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B33813" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Open" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OpenTickets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="12" MouseLeftButtonDown="TicketCard_MouseLeftButtonDown">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TicketNumber}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Border Style="{StaticResource UrgencyBadge}" Margin="0,6,0,8" Visibility="{Binding Urgency, Converter={StaticResource StringToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Urgency}" Foreground="White" />
                                            </Border>
                                            <Button Command="{Binding DataContext.MoveToInProgressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="Start" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="In Progress" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding InProgressTickets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="12" MouseLeftButtonDown="TicketCard_MouseLeftButtonDown">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TicketNumber}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Border Style="{StaticResource UrgencyBadge}" Margin="0,6,0,8" Visibility="{Binding Urgency, Converter={StaticResource StringToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Urgency}" Foreground="White" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.MoveToPendingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="Pending" />
                                                </Button>
                                                <Button Command="{Binding DataContext.MoveToClosedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="Close" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pending User Input" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PendingTickets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="12" MouseLeftButtonDown="TicketCard_MouseLeftButtonDown">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TicketNumber}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Border Style="{StaticResource UrgencyBadge}" Margin="0,6,0,8" Visibility="{Binding Urgency, Converter={StaticResource StringToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Urgency}" Foreground="White" />
                                            </Border>
                                            <Button Command="{Binding DataContext.MoveToInProgressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="Resume" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Closed" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ClosedTickets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="12" MouseLeftButtonDown="TicketCard_MouseLeftButtonDown">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TicketNumber}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Border Style="{StaticResource UrgencyBadge}" Margin="0,6,0,8" Visibility="{Binding Urgency, Converter={StaticResource StringToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Urgency}" Foreground="White" />
                                            </Border>
                                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.MoveToOpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="Reopen" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl
    x:Class="FFTicket.Desktop.Views.KanbanBoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FFTicket.Desktop.Controls">
    <UserControl.Resources>
        <Style x:Key="KanbanListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Kanban Board" />
                    <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="Drag tickets between columns to update their workflow status." />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <TextBlock Foreground="{ThemeResource ErrorTextBrush}" Text="{Binding ErrorMessage}" />
                    <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Refresh board">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="BoardScroller"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            SizeChanged="BoardScroller_SizeChanged"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <Grid x:Name="BoardGrid" MinWidth="960">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    AllowDrop="True"
                    DragOver="StatusColumn_DragOver"
                    Drop="StatusColumn_Drop"
                    Style="{StaticResource Card}"
                    Tag="Open">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,12" FontSize="17" FontWeight="SemiBold" Text="Open" />
                        <ListView
                            Grid.Row="1"
                            CanDragItems="True"
                            CanReorderItems="False"
                            DragItemsCompleted="TicketList_DragItemsCompleted"
                            DragItemsStarting="TicketList_DragItemsStarting"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource KanbanListItemStyle}"
                            ItemsSource="{Binding OpenTickets}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="13"
                                        Background="{ThemeResource ControlBackgroundBrush}"
                                        CornerRadius="12"
                                        DoubleTapped="TicketCard_DoubleTapped">
                                        <StackPanel Spacing="6">
                                            <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding TicketNumber}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" TextWrapping="Wrap" />
                                            <ui:SemanticBadge Kind="Urgency" Text="{Binding Urgency}" />
                                            <Button HorizontalAlignment="Left" Click="StartTicket_Click" Content="Start" Tag="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    AllowDrop="True"
                    DragOver="StatusColumn_DragOver"
                    Drop="StatusColumn_Drop"
                    Style="{StaticResource Card}"
                    Tag="In Progress">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,12" FontSize="17" FontWeight="SemiBold" Text="In Progress" />
                        <ListView
                            Grid.Row="1"
                            CanDragItems="True"
                            CanReorderItems="False"
                            DragItemsCompleted="TicketList_DragItemsCompleted"
                            DragItemsStarting="TicketList_DragItemsStarting"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource KanbanListItemStyle}"
                            ItemsSource="{Binding InProgressTickets}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="13"
                                        Background="{ThemeResource ControlBackgroundBrush}"
                                        CornerRadius="12"
                                        DoubleTapped="TicketCard_DoubleTapped">
                                        <StackPanel Spacing="6">
                                            <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding TicketNumber}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" TextWrapping="Wrap" />
                                            <ui:SemanticBadge Kind="Urgency" Text="{Binding Urgency}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Click="PendingTicket_Click" Content="Pending" Tag="{Binding}" />
                                                <Button Style="{StaticResource SecondaryButton}" Click="CloseTicket_Click" Content="Close" Tag="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    AllowDrop="True"
                    DragOver="StatusColumn_DragOver"
                    Drop="StatusColumn_Drop"
                    Style="{StaticResource Card}"
                    Tag="Pending User Input">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,12" FontSize="17" FontWeight="SemiBold" Text="Pending User Input" />
                        <ListView
                            Grid.Row="1"
                            CanDragItems="True"
                            CanReorderItems="False"
                            DragItemsCompleted="TicketList_DragItemsCompleted"
                            DragItemsStarting="TicketList_DragItemsStarting"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource KanbanListItemStyle}"
                            ItemsSource="{Binding PendingTickets}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="13"
                                        Background="{ThemeResource ControlBackgroundBrush}"
                                        CornerRadius="12"
                                        DoubleTapped="TicketCard_DoubleTapped">
                                        <StackPanel Spacing="6">
                                            <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding TicketNumber}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" TextWrapping="Wrap" />
                                            <ui:SemanticBadge Kind="Urgency" Text="{Binding Urgency}" />
                                            <Button HorizontalAlignment="Left" Click="StartTicket_Click" Content="Resume" Tag="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="3"
                    AllowDrop="True"
                    DragOver="StatusColumn_DragOver"
                    Drop="StatusColumn_Drop"
                    Style="{StaticResource Card}"
                    Tag="Closed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,12" FontSize="17" FontWeight="SemiBold" Text="Closed" />
                        <ListView
                            Grid.Row="1"
                            CanDragItems="True"
                            CanReorderItems="False"
                            DragItemsCompleted="TicketList_DragItemsCompleted"
                            DragItemsStarting="TicketList_DragItemsStarting"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource KanbanListItemStyle}"
                            ItemsSource="{Binding ClosedTickets}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="13"
                                        Background="{ThemeResource ControlBackgroundBrush}"
                                        CornerRadius="12"
                                        DoubleTapped="TicketCard_DoubleTapped">
                                        <StackPanel Spacing="6">
                                            <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding TicketNumber}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" TextWrapping="Wrap" />
                                            <ui:SemanticBadge Kind="Urgency" Text="{Binding Urgency}" />
                                            <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="ReopenTicket_Click" Content="Reopen" Tag="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

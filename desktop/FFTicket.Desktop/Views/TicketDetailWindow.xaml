<Window x:Class="FFTicket.Desktop.Views.TicketDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticket Detail"
        Width="920"
        Height="720"
        WindowStartupLocation="CenterOwner">
    <DockPanel Background="{StaticResource AppBackgroundBrush}" Margin="12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Ticket.TicketNumber}" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Ticket.Subject}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Ticket.Description}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Border Style="{StaticResource StatusBadge}">
                        <TextBlock Text="{Binding Ticket.Status}" Foreground="White" />
                    </Border>
                    <Button Command="{Binding MarkClosedCommand}" Margin="0,12,0,0" Visibility="{Binding CanManageInternalNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Mark as Closed" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Audit History" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding AuditLogs}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Action}" />
                                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding CreatedAt}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Internal Notes" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding Comments}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding CreatedByName}" />
                                        <Run Text=" - " />
                                        <Run Text="{Binding CreatedAt}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Width="360">
                        <TextBlock Text="Attachments" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Attachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CanManageInternalNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Add Internal Note" FontWeight="SemiBold" />
                        <TextBox Tag="Add an internal note" Text="{Binding NewInternalNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
                        <Button Command="{Binding AddNoteCommand}" HorizontalAlignment="Right">
                            <TextBlock Text="Add Note" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>

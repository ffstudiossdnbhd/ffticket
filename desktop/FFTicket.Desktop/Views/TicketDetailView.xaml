<UserControl
    x:Name="DetailRoot"
    x:Class="FFTicket.Desktop.Views.TicketDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FFTicket.Desktop.Controls">
    <StackPanel Spacing="16">
        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
            <TextBlock VerticalAlignment="Center" Text="Loading ticket..." />
        </StackPanel>

        <Border
            Style="{StaticResource MessageSurface}"
            Background="{ThemeResource ErrorSurfaceBrush}"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Foreground="{ThemeResource ErrorTextBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Spacing="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding Ticket.TicketNumber}" />
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Ticket.Subject}" TextWrapping="Wrap" />
                </StackPanel>
                <ui:SemanticBadge
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Kind="Status"
                    Text="{Binding Ticket.Status}" />
            </Grid>
            <ui:SemanticBadge Kind="Urgency" Text="{Binding Ticket.Urgency}" />
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Location: " />
                <Run Text="{Binding Ticket.LocationName}" />
            </TextBlock>
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Description: " />
                <Run Text="{Binding Ticket.Description}" />
            </TextBlock>
        </StackPanel>

        <Border
            Padding="12"
            Background="{ThemeResource ControlBackgroundBrush}"
            CornerRadius="10"
            Visibility="{Binding HasCollaborators, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="5">
                <TextBlock FontWeight="SemiBold" Text="Other team members on this ticket" />
                <ItemsControl ItemsSource="{Binding Collaborators}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding DisplayState}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Height="1" Background="{ThemeResource CardBorderBrush}" />

        <StackPanel Spacing="8">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Attachments" />
            <ItemsControl ItemsSource="{Binding Attachments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Margin="0,0,8,0" FontSize="15" Glyph="&#xE723;" />
                            <HyperlinkButton
                                Grid.Column="1"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="Attachment_Click"
                                Content="{Binding FileName}"
                                Tag="{Binding}"
                                ToolTipService.ToolTip="Open attachment" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Audit History" />
            <ItemsControl ItemsSource="{Binding AuditLogs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,6"
                            Padding="12"
                            Background="{ThemeResource ControlBackgroundBrush}"
                            CornerRadius="10">
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Action}" />
                                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding Notes}" TextWrapping="Wrap" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding CreatedAt}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Comments" />
            <ItemsControl ItemsSource="{Binding Comments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,6"
                            Padding="12"
                            Background="{ThemeResource ControlBackgroundBrush}"
                            CornerRadius="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding CreatedByName}" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="·" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="{Binding CreatedAt}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel
            Spacing="8"
            Visibility="{Binding CanManageInternalNotes, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Add Comment" />
            <TextBox
                MinHeight="90"
                AcceptsReturn="True"
                GotFocus="EditControl_GotFocus"
                PlaceholderText="Add an internal comment"
                Text="{Binding NewInternalNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding MarkClosedCommand}"
                    Content="Mark as Closed" />
                <Button Grid.Column="2" Command="{Binding AddNoteCommand}" Content="Add Comment" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>

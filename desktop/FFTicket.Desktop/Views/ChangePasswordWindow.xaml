<Window x:Class="FFTicket.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password"
        Width="380"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Style="{StaticResource Card}" Width="310" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Change Password" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

                <Border Background="#ECFDF3" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534" />
                </Border>
                <Border Background="#FFF3EE" BorderBrush="#FFD0BF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#B33813" />
                </Border>

                <TextBlock Text="Current Password" Foreground="{StaticResource TextSecondaryBrush}" />
                <PasswordBox x:Name="CurrentPasswordInput" />

                <TextBlock Text="New Password" Foreground="{StaticResource TextSecondaryBrush}" />
                <PasswordBox x:Name="NewPasswordInput" />

                <TextBlock Text="Confirm New Password" Foreground="{StaticResource TextSecondaryBrush}" />
                <PasswordBox x:Name="ConfirmPasswordInput" />

                <Button Click="ChangePassword_Click">
                    <TextBlock Text="Change Password" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

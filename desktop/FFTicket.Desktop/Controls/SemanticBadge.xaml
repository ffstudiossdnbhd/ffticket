<UserControl
    x:Class="FFTicket.Desktop.Controls.SemanticBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="BadgeSurface"
        MinWidth="64"
        Padding="10,4"
        HorizontalAlignment="Left"
        CornerRadius="12">
        <TextBlock
            x:Name="BadgeText"
            HorizontalAlignment="Center"
            FontSize="12"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis" />
    </Border>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIconTaskbar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="dotenv.net" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\AppIcon.png" />
    <None Remove="Assets\AppIconTaskbar.png" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\AppIconTaskbar.png" />
  </ItemGroup>

  <ItemGroup Condition="Exists('.env')">
    <None Remove=".env" />
    <EmbeddedResource Include=".env" LogicalName="FFTicket.Desktop.env" />
  </ItemGroup>
</Project>
